PORT=3000
JWT_SECRET=CHANGE_THIS_TO_A_LONG_RANDOM_SECRET
COMPANY_NAME=Toybox Toy Manufacturing Pvt. Ltd.

# --- PostgreSQL database (REQUIRED) -----------------------------------------
# SABIHA ERP v13 stores all data in PostgreSQL. Install PostgreSQL (see
# POSTGRESQL_SETUP_v13.md), then put the details you chose during installation here.
# The database is created automatically on first start if it does not exist
# (set PG_AUTO_CREATE_DB=false to disable that).
PGHOST=localhost
PGPORT=5432
PGDATABASE=sabiha_default
PGUSER=postgres
PGPASSWORD=159963
# ...or use ONE connection string instead of the five lines above:
# DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@localhost:5432/sabiha_erp
# Set to true for cloud/managed PostgreSQL that requires an encrypted connection
PGSSL=false
PG_AUTO_CREATE_DB=true

# --- Security (all optional — sane defaults are used if left unset) --------
# Comma-separated list of origins allowed to call this API from a browser.
# Leave blank to allow only same-origin requests (the normal case — the
# frontend is served by this same app). Only set this if you're hosting the
# frontend somewhere else and calling this API from there.
ALLOWED_ORIGINS=
# Max API requests a single IP can make in a 15-minute window before getting
# a 429 (Too Many Requests) — protects against traffic floods / basic DoS.
RATE_LIMIT_MAX=300
# Max /auth/login attempts a single IP can make in a 15-minute window,
# separate from (and in addition to) the 5-attempts-per-User-ID/24-hour
# lockout already enforced per account.
LOGIN_RATE_LIMIT_MAX=20
# Set to 1 only if this app runs behind a reverse proxy / load balancer
# (nginx, IIS, a cloud load balancer) — needed so rate limiting sees the
# real visitor IP instead of the proxy's IP. Leave as 0 for a normal
# direct install (running the .exe or `npm start` directly).
TRUST_PROXY=0
# Max size of a single request body (base64 logo uploads and database
# restores need headroom here). Increase only if a database restore starts
# failing with a "payload too large" error as your data grows.
MAX_BODY_SIZE=40mb
# WhatsApp Business Cloud API — required for automatic PDF attachments.
# Get these values from your Meta WhatsApp Business / Cloud API setup.
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_GRAPH_API_VERSION=v23.0

# SMS OTP — MSG91 Flow API. Configure these from Settings → SMS Gateway.
SMS_PROVIDER=MSG91
SMS_API_URL=https://control.msg91.com/api/v5/flow
SMS_AUTH_KEY=
SMS_TEMPLATE_ID=
SMS_SENDER_ID=
SMS_COUNTRY_CODE=91
SMS_VARIABLE_NAME=VAR1
SMS_OTP_ENABLED=0
SMS_OTP_EXPIRY_MINUTES=5
SMS_OTP_RESEND_SECONDS=30


# --- Multi-company / SaaS tenancy ------------------------------------------
# The PGDATABASE above is the built-in/default tenant database. The platform
# registry is kept in a separate database and never contains ERP transactions.
PLATFORM_DATABASE=sabiha_platform
DEFAULT_COMPANY_CODE=DEFAULT
DEFAULT_COMPANY_NAME=Your Company
PLATFORM_ADMIN_KEY=CHANGE_THIS_TO_A_LONG_RANDOM_PLATFORM_KEY

# --- Platform Owner (Super Admin) ------------------------------------------
# The owner/developer signs in at  http://localhost:3000/platform.html  to create
# companies, approve company requests and monitor every company.
# Leave SUPERADMIN_PASSWORD empty and a random first password is generated and
# shown ONCE in the start-up window (also saved to data/SUPERADMIN_FIRST_PASSWORD.txt);
# you must change it at first sign-in. Or set your own (8+ chars, letters + numbers):
SUPERADMIN_USERNAME=SUPERADMIN
SUPERADMIN_PASSWORD=admin123456
# Show the list of active companies in the login page's company selector.
# Set to false to hide it — users then have to type their Company ID.
PUBLIC_COMPANY_LIST=true
# Anti-abuse limits per device (IP address)
COMPANY_REQUEST_LIMIT_PER_HOUR=10
REGISTER_RATE_LIMIT_PER_HOUR=30
# Maximum number of tenant DB connections kept warm in the Node process.
MAX_TENANT_CONNECTIONS=50
# Do not point PGDATABASE at PLATFORM_DATABASE.

# ---------------------------------------------------------------------------
# v5.2 — platform owner features
# ---------------------------------------------------------------------------
# Emergency switch: ignore the console IP allow-list (Platform console →
# Team & Security). Use it only if you locked yourself out, then remove it.
# PLATFORM_IP_ALLOWLIST_DISABLE=1
#
# Everything else (plans, grace period, platform email, backups, branding,
# announcements, billing) is configured inside the Platform Owner console.
# Back-ups are written to data/company-backups/ — copy that folder off the
# server regularly.

# ---------------------------------------------------------------------------
# v5.3 — apps
# ---------------------------------------------------------------------------
# Behind nginx on a VPS set TRUST_PROXY=1 (see HOSTING_VPS.md). The Android/iOS
# app origins are always allowed; ALLOWED_ORIGINS is only for other websites.
